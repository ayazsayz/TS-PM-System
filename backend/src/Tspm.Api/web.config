<?xml version="1.0" encoding="utf-8"?>
<!--
  Base web.config. `dotnet publish` fills in processPath/arguments for the ASP.NET Core Module;
  the settings below are preserved.

  stdoutLogEnabled="true" writes startup errors to .\logs\stdout_*.log so a failed boot on the
  host is diagnosable (create a `logs` folder at the site root if the module can't). Turn this
  off (false) once the site is healthy — it has a small perf cost.

  ASPNETCORE_ENVIRONMENT=Production ensures appsettings.Production.json is loaded regardless of
  the host default.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Tspm.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
